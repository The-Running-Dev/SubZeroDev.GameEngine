# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# NOT `build/`. That pattern used to be here and silently swallowed the
# documentation system's installed *source* scripts in ./build --
# Test-Documentation.ps1 and ConvertTo-DocumentationHomepage.ps1. The two
# already-tracked files kept working, but any script a later `Invoke-SetupDocs`
# added there would have been invisible to `git add -A`: present locally, green
# locally, missing in CI, with nothing saying why. TypeScript emits to dist/
# (src/engine/tsconfig.json outDir), so the bare pattern was protecting nothing.

# npm pack output. `npm pack` writes <name>-<version>.tgz beside package.json, and
# W41 made that a routine step rather than a rare one -- the CI `engine` job packs on
# every run, and the consumer smoke path installs that tarball rather than a source
# link, deliberately (plans/40, Decision 2). So a ~400 KB binary now lands untracked in
# the working tree after any packaging run, in exactly the position `git add -A` would
# sweep it up. Regenerable from the build; a build artifact in the history is what the
# `dist/` rule above already refuses.
*.tgz

# Docusaurus local build
.docusaurus/
docs/build/

# Built documentation site, written by Invoke-DocsBuild -OutputPath artifacts/docs
# during local verification. Regenerable; committing it would add the whole
# rendered site to the repository.
artifacts/

# Per-machine session costs, written by the SessionEnd hook. Regenerable from
# the transcripts at any time, and meaningless on another machine.
.claude/session-costs.tsv

# graphify — regenerable and expensive; never commit
graphify-out/
.graphify_*

# Env / secrets
.env
.env.*
*.local

# .npmrc carries the GitHub Packages auth token. release-engine-package.yml writes one
# at publish time, which is ephemeral on a runner -- but anyone reproducing those steps
# locally, or debugging a failed publish, leaves a credential-bearing file sitting
# untracked in src/engine/. This is the one ignored path here whose absence would leak
# a secret rather than merely add noise.
.npmrc

# .NET build output (src/host/) -- restore/build artifacts, not source.
[Bb]in/
[Oo]bj/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
