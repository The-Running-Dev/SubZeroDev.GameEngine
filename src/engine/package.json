{
  "name": "@the-running-dev/game-engine",
  "version": "0.5.0",
  "type": "module",
  "description": "Deterministic narrative game engine — core + kinds. Specs: ../../docs/docs/engine/.",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Running-Dev/SubZeroDev.GameEngine.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts",
    "demo": "tsx scripts/demo-cli.ts",
    "spike:export": "tsx scripts/spike-export-campaigns.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  }
}
