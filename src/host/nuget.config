<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scoped to src/host/ by placement (NuGet walks up from a project directory to find
       the nearest nuget.config), so it changes restore behavior for this host and nothing
       else in the repository. No credential is committed: %NUGET_GITHUB_ACTOR% and
       %NUGET_GITHUB_TOKEN% are expanded from the environment at restore time, and CI and
       the container build set them from a short-lived token, per
       design/15-platform-static-host.md §3 and §5. -->
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/The-Running-Dev/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%NUGET_GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%NUGET_GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
